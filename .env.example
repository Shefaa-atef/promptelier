# Optional. Defaults are sufficient for local development.
PROMPTELIER_DB=data/promptelier.sqlite3

PROMPTELIER_OUTPUTS=outputs

# Set these in PowerShell before starting the servers; this file is not auto-loaded.
PROMPTELIER_BACKEND_URL=http://127.0.0.1:8002
PROMPTELIER_CARD_ENGINE=auto
PROMPTELIER_PRESENTER_ENGINE=auto
PROMPTELIER_VOICE_ENGINE=auto
